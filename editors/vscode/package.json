{
  "name": "kiro-language",
  "displayName": "Kiro",
  "description": "Syntax highlighting for Kiro scripts",
  "publisher": "darnix-a",
  "version": "0.1.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/Darnix-a/kiro.git",
    "directory": "editors/vscode"
  },
  "engines": { "vscode": "^1.80.0" },
  "categories": ["Programming Languages"],
  "files": ["language-configuration.json", "syntaxes/"],
  "contributes": {
    "languages": [
      {
        "id": "kiro",
        "aliases": ["Kiro"],
        "extensions": [".kr"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "kiro",
        "scopeName": "source.kiro",
        "path": "./syntaxes/kiro.tmLanguage.json"
      }
    ]
  }
}
